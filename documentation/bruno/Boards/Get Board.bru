meta {
  name: Get Board
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/boards/{{boardId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns 200 for the owner", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.id).to.equal(bru.getEnvVar("boardId"));
  });
}

docs {
  Read-leak policy: another user's board id returns 404 (not 403) so an attacker cannot enumerate ids by probing.
}
