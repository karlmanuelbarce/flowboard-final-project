// Worker-only schema: minimal subset of api/prisma/schema.prisma.
// The worker only writes AuditLog rows; the API owns the migrations and the
// other models. Keep the AuditLog field list in sync if it changes upstream.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
}
