# Node
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres (used by the db service and the Prisma DATABASE_URL)
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=flowboard
POSTGRES_DB=flowboard
DATABASE_URL=postgresql://flowboard:flowboard@db:5432/flowboard?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Auth — generate prod secrets with `openssl rand -base64 48` (min 32 chars enforced at boot)
JWT_ACCESS_SECRET=dev-only-access-secret-please-replace-in-prod-xxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=dev-only-refresh-secret-please-replace-in-prod-xxxxxxxxxxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Host port mapping for nginx (the other ports stay inside the Docker network)
NGINX_PORT=8081

# CORS
ALLOWED_ORIGINS=http://localhost,http://localhost:8081
